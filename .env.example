# Clerk (run `clerk env pull` to fill these, or copy from dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional: extra Clerk user ids allowed besides the owner (comma-separated)
# OCTAVE_ALLOWED_USERS=user_abc,user_def

# Optional: serve Octave on another machine (e.g. a GPU box). Requires Clerk.
# OCTAVE_PUBLIC_URL=https://octave.my-gpu-box.example
