{
  "name": "octave",
  "version": "0.1.0",
  "description": "Run a fleet of coding agents in parallel, with pre-merge conflict radar, risk-ranked review, and agent tournaments.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build --logLevel warn && tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "tsx scripts/demo.ts",
    "prepare": "vite build --logLevel warn"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@clerk/express": "^2.1.78",
    "@clerk/react": "^6.17.8",
    "@clerk/ui": "^1.40.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "express": "^5.3.0",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "ws": "^8.22.0"
  },
  "allowScripts": {
    "node-pty@1.0.0": true
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "bin": {
    "octave": "bin/octave.js"
  },
  "engines": {
    "node": ">=20"
  }
}
